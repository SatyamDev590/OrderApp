FROM postgres:15.1

ARG ORDER_APP_POSTGRES_USER
ARG ORDER_APP_POSTGRES_PASSWORD

ENV POSTGRES_DB=utilities \
    POSTGRES_USER=$ORDER_APP_POSTGRES_USER \
    POSTGRES_PASSWORD=$ORDER_APP_POSTGRES_PASSWORD \
    PGDATA=/var/lib/postgresql/data/pgdata \
    POSTGRES_HOST_AUTH_METHOD=md5

# Create and set required directories as the postgres user
RUN mkdir -p /var/lib/postgresql/data/pgdata && \
    mkdir -p /var/run/postgresql && \
    chown -R postgres:postgres /var/lib/postgresql /var/run/postgresql && \
    chmod 700 /var/lib/postgresql/data/pgdata && \
    chmod 775 /var/run/postgresql

# Switch to the default postgres user (created by the base image)
USER postgres

# Set the entrypoint
ENTRYPOINT ["docker-entrypoint.sh"]

# Start PostgreSQL server
CMD ["postgres"]

# Expose PostgreSQL port
EXPOSE 5432
